{
  "name": "reel-ia-designer",
  "version": "1.0.0",
  "private": true,
  "description": "Gerador de Reels faceless 1080x1920 em Remotion (roteiros em src/videos/)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render ReelIA30 out/reel-30fps.mp4",
    "render:60": "remotion render ReelIA60 out/reel-60fps.mp4",
    "render:cowork": "remotion render ClaudeCowork30 out/claude-cowork-30fps.mp4",
    "render:cowork:60": "remotion render ClaudeCowork60 out/claude-cowork-60fps.mp4",
    "still": "remotion still ReelIA30 out/thumb.png --frame=20",
    "still:cowork": "remotion still ClaudeCowork30 out/claude-cowork-thumb.png --frame=40",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/montserrat": "5.2.8",
    "@fontsource/source-serif-4": "5.2.9",
    "@remotion/cli": "4.0.539",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
